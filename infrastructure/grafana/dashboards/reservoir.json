      },
      "datasource": {
        "type": "influxdb",
        "uid": "reservoir-influxdb"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"reservoir-bucket\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"reservoir_data\" and r._field == \"niveau\")\n  |> last()"
        }
